//| mill-version:1.0.5

import mill._, scalalib._, scalafmt._
import mainargs.arg

object `package` extends ScalaModule with ScalafmtModule {
  def scalaVersion = "2.13.14"
  def spinalVersion = "1.13.0"

  def mvnDeps = Seq(
    mvn"com.github.spinalhdl::spinalhdl-core:$spinalVersion",
    mvn"com.github.spinalhdl::spinalhdl-lib:$spinalVersion"
  )

  def scalacPluginMvnDeps = Seq(mvn"com.github.spinalhdl::spinalhdl-idsl-plugin:$spinalVersion")

  def format() = Task.Command { reformat()() }

  def constraints = Task.Source(moduleDir / "src" / "Colorlight-5A-75E.lpf")

  def generate(@arg(positional = true) className: String) = Task.Command {
    compile()

    os.proc(
      "java",
      "-cp",
      runClasspath().map(_.path).mkString(":"),
      "lime.util.Config",
      className
    ).call(cwd = Task.dest, stdout = os.Inherit, stderr = os.Inherit)

    PathRef(Task.dest / s"${className.split('.').last}.v")
  }

  def synthesize(@arg(positional = true) className: String) = Task.Command {
    val simpleName  = className.split('.').last
    val verilogFile = generate(className)().path
    val synthFile   = Task.dest / s"$simpleName.json"

    os.proc(
      "yosys",
      "-q",
      "-p",
      s"synth_ecp5 -top $simpleName -json ${synthFile}",
      verilogFile
    ).call(cwd = Task.dest)

    PathRef(synthFile)
  }

  def placeAndRoute(@arg(positional = true) className: String) = Task.Command {
    val simpleName = className.split('.').last
    val synthFile  = synthesize(className)().path
    val lpfFile    = constraints().path
    val cfgFile    = Task.dest / s"$simpleName.cfg"

    os.proc(
      "nextpnr-ecp5",
      "--25k",
      "--package", "CABGA256",
      "--speed", "6",
      "--top", simpleName,
      "--json", synthFile,
      "--textcfg", cfgFile,
      "--lpf", lpfFile
    ).call(cwd = Task.dest)

    PathRef(cfgFile)
  }

  def bitstream(@arg(positional = true) className: String) = Task.Command {
    val simpleName    = className.split('.').last
    val cfgFile       = placeAndRoute(className)().path
    val bitstreamFile = Task.dest / s"$simpleName.bit"

    os.proc(
      "ecppack",
      cfgFile,
      bitstreamFile
    ).call(cwd = Task.dest)

    println(s"Bitstream ready at $bitstreamFile")
    PathRef(bitstreamFile)
  }

  def program(@arg(positional = true) className: String, flash: mainargs.Flag) = Task.Command {
    val bitstreamFile = bitstream(className)().path

    os.proc(
      "openFPGALoader",
      "--cable",
      "usb-blaster",
      if (flash.value) Seq("--unprotect-flash", "-f") else Seq(),
      bitstreamFile
    ).call(cwd = Task.dest)
  }
}
